# Datasets — never committed regardless of mount location
/data/
*.tar.gz
*.zip

# Model weights and outputs
*.pth
*.onnx
*.bin
*.engine
*.trt
outputs/
work_dirs/

# Experiment artifacts tracked deliberately (override rules above)
!challenges/embedded-semantic-segmentation/fun_experiments/**/*.onnx
!challenges/embedded-semantic-segmentation/fun_experiments/**/*.log
!challenges/embedded-semantic-segmentation/phase1/**/*.onnx
!challenges/embedded-semantic-segmentation/phase1/**/*.pth
!challenges/embedded-semantic-segmentation/phase1/**/*.log
!challenges/embedded-semantic-segmentation/phase1/notes.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
.conda/
.pixi/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs (keep experiment-log.md, ignore training logs)
*.log
*.out
*.err

# WandB local run cache (written to WANDB_DIR; never commit)
wandb/

# Credentials and tokens
.env
*.token
.secrets/

# Jupyter
.ipynb_checkpoints/

# Analysis intermediate artifacts (HTML intermediates from weasyprint)
challenges/common/lars-analysis/*.html
challenges/common/lars-analysis/whole_image_ood/report.html
challenges/common/lars-analysis/reports/*.html
challenges/common/lars-analysis/spatial_ood/spatial_report.html

# Spatial OOD extension — large intermediate files (not committed)
challenges/common/lars-analysis/spatial_ood/*.dat
challenges/common/lars-analysis/spatial_ood/train_patch_meta.npy
challenges/common/lars-analysis/spatial_ood/train_token_counts.npy
challenges/common/lars-analysis/spatial_ood/phase1b_written.npy
challenges/common/lars-analysis/spatial_ood/aggregate_heatmap.npy
# faiss_index.bin is already covered by *.bin above

# Explicitly track the lars analysis log despite *.log rule
!challenges/common/lars-analysis/logs/analysis.log

# Explicitly track the spatial OOD log despite *.log rule
!challenges/common/lars-analysis/logs/spatial_ood.log

# Claude Code local settings (credentials mounted, not committed)
.claude/settings.local.json