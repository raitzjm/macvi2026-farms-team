.venv/
venv/
env/
.conda/
.pixi/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs (keep experiment-log.md, ignore training logs)
*.log
*.out
*.err

# Credentials and tokens
.env
*.token
.secrets/

# Jupyter
.ipynb_checkpoints/

